{
  "name": "acsprojectmanager",
  "private": true,
  "description": "Development tools only. The app itself (frontend/) has no build step.",
  "scripts": {
    "lint": "eslint frontend tests scripts eslint.config.js",
    "build:setup": "node scripts/build-setup.js",
    "check:setup": "node scripts/build-setup.js --check",
    "test:db": "bash tests/db/run.sh",
    "test:e2e": "node tests/e2e/app.test.js",
    "screenshots": "node tests/e2e/screenshots.js",
    "test": "npm run lint && npm run check:setup && npm run test:e2e"
  },
  "devDependencies": {
    "eslint": "10.1.0",
    "playwright": "1.63.0"
  }
}
