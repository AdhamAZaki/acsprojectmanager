// ACS Project Tracker backend: ALL FILES IN ONE.
// Paste this whole file into Code.gs in Apps Script (replace everything there).
// Generated by tools/bundle-backend.sh; edit the separate backend/*.gs files instead.

// ===================== Code.gs =====================

/**
 * ACS Project Tracker — Google Apps Script backend.
 *
 * Deploy as a Web App (Execute as: Me, Who has access: Anyone).
 * Anyone can reach the URL, but every action except "login" requires a
 * signed session token, which is only issued to an Active member of the
 * Team sheet who gives the right username and password.
 *
 * Request:  POST, body = JSON { action, token, payload }  (sent as text/plain
 *           so the browser does not need a CORS preflight)
 * Response: JSON { ok: true, data } or { ok: false, error, code }
 */

class AppError extends Error {
  constructor(message, code) {
    super(message);
    this.code = code || 400;
  }
}

function getRoutes_() {
  return {
    // Public
    login:           { auth: false, fn: actionLogin },

    // Any signed-in member
    me:              { fn: (p, user) => user },
    myProjects:      { fn: actionMyProjects },
    myUpdates:       { fn: actionMyUpdates },
    saveUpdate:      { fn: actionSaveUpdate },
    changePassword:  { fn: actionChangePassword },
    listMeetings:    { fn: actionListMeetings },

    // Admins only
    listProjects:    { admin: true, fn: () => listProjects_() },
    saveProject:     { admin: true, fn: actionSaveProject },
    listTeam:        { admin: true, fn: () => listTeam_() },
    saveMember:      { admin: true, fn: actionSaveMember },
    listAssignments: { admin: true, fn: () => listAssignments_() },
    setAssignments:  { admin: true, fn: actionSetAssignments },
    weekReport:      { admin: true, fn: actionWeekReport },
    saveMeeting:     { admin: true, fn: actionSaveMeeting },
  };
}

function doPost(e) {
  let body;
  try {
    body = JSON.parse(e.postData.contents);
  } catch (err) {
    return json_({ ok: false, error: 'Invalid request body', code: 400 });
  }

  try {
    const route = getRoutes_()[body.action];
    if (!route) throw new AppError('Unknown action: ' + body.action, 404);

    let user = null;
    if (route.auth !== false) {
      user = requireSession_(body.token);
      if (route.admin && user.role !== 'Admin') {
        throw new AppError('Admin access required', 403);
      }
    }
    const data = route.fn(body.payload || {}, user);
    return json_({ ok: true, data: data });
  } catch (err) {
    const known = err instanceof AppError;
    if (!known) console.error(err && err.stack ? err.stack : err);
    return json_({
      ok: false,
      error: known ? err.message : 'Server error. Please try again.',
      code: known ? err.code : 500,
    });
  }
}

function doGet() {
  return json_({ ok: true, service: 'ACS Project Tracker API' });
}

function json_(obj) {
  return ContentService.createTextOutput(JSON.stringify(obj))
    .setMimeType(ContentService.MimeType.JSON);
}

// ===================== Sheets.gs =====================

/**
 * Thin data layer over the Google Sheet. Each tab is a table whose first row
 * holds the column headers below.
 */

const SHEETS = {
  Projects:      ['ProjectID', 'Name', 'Type', 'Client', 'Manager', 'Status', 'StartDate', 'EndDate', 'Notes'],
  Team:          ['Username', 'Password', 'Name', 'Role', 'Active'],
  Assignments:   ['ProjectID', 'Username'],
  WeeklyUpdates: ['UpdateID', 'Week', 'Username', 'Name', 'ProjectID', 'ProjectName', 'DoneThisWeek',
                  'PlanNextWeek', 'Blockers', 'Status', 'Progress', 'SubmittedAt', 'UpdatedAt'],
  Meetings:      ['MeetingID', 'Date', 'Week', 'Title', 'Attendees', 'Notes', 'Decisions',
                  'ActionItems', 'CreatedBy', 'CreatedAt'],
};

const PROJECT_TYPES = ['PLC', 'AVEVA', 'Other'];
const PROJECT_STATUSES = ['Active', 'On Hold', 'Completed', 'Closed'];
const UPDATE_STATUSES = ['On Track', 'At Risk', 'Delayed', 'Blocked', 'Done'];
const ROLES = ['Member', 'Admin'];

function ss_() {
  const id = PropertiesService.getScriptProperties().getProperty('SPREADSHEET_ID');
  return id ? SpreadsheetApp.openById(id) : SpreadsheetApp.getActiveSpreadsheet();
}

function sheet_(name) {
  const sh = ss_().getSheetByName(name);
  if (!sh) throw new AppError('Sheet "' + name + '" is missing. Run setup() in Apps Script.', 500);
  return sh;
}

function headers_(sh) {
  return sh.getRange(1, 1, 1, Math.max(sh.getLastColumn(), 1)).getValues()[0];
}

/** Returns rows as objects keyed by header, plus _row (1-based sheet row). */
function readTable_(name) {
  const sh = sheet_(name);
  const values = sh.getDataRange().getValues();
  const headers = values.shift() || [];
  const tz = Session.getScriptTimeZone();
  const rows = [];
  values.forEach((row, i) => {
    if (row.every(v => v === '' || v === null)) return;
    const obj = { _row: i + 2 };
    headers.forEach((h, c) => { if (h) obj[h] = normalizeCell_(row[c], tz); });
    rows.push(obj);
  });
  return rows;
}

function normalizeCell_(v, tz) {
  if (v instanceof Date) {
    const hasTime = v.getHours() || v.getMinutes() || v.getSeconds();
    return Utilities.formatDate(v, tz, hasTime ? 'yyyy-MM-dd HH:mm' : 'yyyy-MM-dd');
  }
  return v;
}

/** Writes a record; updates rowNumber if given, otherwise appends. */
function writeRecord_(name, record, rowNumber) {
  const sh = sheet_(name);
  const row = headers_(sh).map(h => toCell_(record[h]));
  if (rowNumber) sh.getRange(rowNumber, 1, 1, row.length).setValues([row]);
  else sh.appendRow(row);
}

/** Replaces all data rows of a sheet (header kept). */
function rewriteTable_(name, records) {
  const sh = sheet_(name);
  const headers = headers_(sh);
  if (sh.getLastRow() > 1) sh.getRange(2, 1, sh.getLastRow() - 1, headers.length).clearContent();
  if (records.length) {
    sh.getRange(2, 1, records.length, headers.length)
      .setValues(records.map(r => headers.map(h => toCell_(r[h]))));
  }
}

/** Prevents user text such as "=IMPORTXML(...)" or "- item" being treated as a formula. */
function toCell_(v) {
  if (v === undefined || v === null) return '';
  if (typeof v === 'string' && /^[=+\-@]/.test(v)) return "'" + v;
  return v;
}

function withLock_(fn) {
  const lock = LockService.getScriptLock();
  lock.waitLock(20000);
  try {
    return fn();
  } finally {
    lock.releaseLock();
  }
}

function same_(a, b) {
  return String(a).trim().toLowerCase() === String(b).trim().toLowerCase();
}

function isActive_(v) {
  return v === true || /^(true|yes|y|1)$/i.test(String(v).trim());
}

function text_(v, max) {
  return String(v === undefined || v === null ? '' : v).trim().slice(0, max || 5000);
}

function oneOf_(v, list, fallback) {
  const match = list.find(x => same_(x, v || ''));
  return match || fallback;
}

function nowStamp_() {
  return Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'yyyy-MM-dd HH:mm');
}

// ---------- Mappers (sheet row -> API object) ----------

function mapProject_(r) {
  return {
    id: String(r.ProjectID), name: r.Name, type: r.Type, client: r.Client, manager: r.Manager,
    status: r.Status, startDate: r.StartDate, endDate: r.EndDate, notes: r.Notes,
  };
}

/** Never includes the Password column. */
function mapMember_(r) {
  return {
    username: normUser_(r.Username), name: r.Name || r.Username,
    role: oneOf_(r.Role, ROLES, 'Member'), active: isActive_(r.Active),
  };
}

function mapUpdate_(r) {
  return {
    id: r.UpdateID, week: String(r.Week), username: normUser_(r.Username), name: r.Name,
    projectId: String(r.ProjectID), projectName: r.ProjectName,
    done: r.DoneThisWeek, next: r.PlanNextWeek, blockers: r.Blockers,
    status: r.Status, progress: r.Progress === '' ? null : Number(r.Progress),
    submittedAt: r.SubmittedAt, updatedAt: r.UpdatedAt,
  };
}

function mapMeeting_(r) {
  return {
    id: r.MeetingID, date: r.Date, week: String(r.Week), title: r.Title, attendees: r.Attendees,
    notes: r.Notes, decisions: r.Decisions, actionItems: r.ActionItems,
    createdBy: r.CreatedBy, createdAt: r.CreatedAt,
  };
}

// ---------- Queries ----------

function listProjects_() {
  return readTable_('Projects').map(mapProject_);
}

function listTeam_() {
  return readTable_('Team').map(mapMember_);
}

function listAssignments_() {
  return readTable_('Assignments').map(r => ({
    projectId: String(r.ProjectID), username: normUser_(r.Username),
  }));
}

/** Active team member by username, or null. */
function findMember_(username) {
  const row = readTable_('Team').find(r => same_(r.Username, username));
  if (!row || !isActive_(row.Active)) return null;
  const m = mapMember_(row);
  return { username: m.username, name: m.name, role: m.role };
}

// ===================== Auth.gs =====================

/**
 * Authentication against the Team sheet (Username + Password columns).
 *
 * An admin types a plain password into the Password cell. On the user's
 * first successful login it is replaced by a salted hash ("$h1$salt$hash"),
 * so from then on nobody can read it from the Sheet. To reset a password,
 * type a new plain one into the cell.
 *
 * After a successful login we issue our own HMAC-signed session token.
 */

const SESSION_HOURS = 12;
const HASH_PREFIX = '$h1$';
const HASH_ROUNDS = 1000;
const MAX_FAILED_LOGINS = 5;
const LOCKOUT_SECONDS = 15 * 60;

function actionLogin(payload) {
  const username = normUser_(payload.username);
  const password = String(payload.password || '');
  if (!username || !password) throw new AppError('Enter your username and password.', 401);

  const cache = CacheService.getScriptCache();
  const failKey = 'fail:' + username;
  const fails = Number(cache.get(failKey) || 0);
  if (fails >= MAX_FAILED_LOGINS) {
    throw new AppError('Too many failed attempts. Try again in 15 minutes.', 429);
  }

  return withLock_(() => {
    const row = readTable_('Team').find(r => same_(r.Username, username));
    const ok = row && isActive_(row.Active) && checkPassword_(password, String(row.Password || ''));
    if (!ok) {
      cache.put(failKey, String(fails + 1), LOCKOUT_SECONDS);
      throw new AppError('Wrong username or password.', 401);
    }
    cache.remove(failKey);

    // First login after an admin set a plain password: store it hashed instead.
    if (!isHashed_(row.Password)) {
      writeRecord_('Team', Object.assign({}, row, { Password: hashPassword_(password) }), row._row);
    }
    const member = mapMember_(row);
    return {
      token: createSession_(member.username),
      user: { username: member.username, name: member.name, role: member.role },
    };
  });
}

function actionChangePassword(p, user) {
  const current = String(p.current || '');
  const next = String(p.next || '');
  if (next.length < 8) throw new AppError('The new password must be at least 8 characters.');

  return withLock_(() => {
    const row = readTable_('Team').find(r => same_(r.Username, user.username));
    if (!row || !checkPassword_(current, String(row.Password || ''))) {
      throw new AppError('Your current password is not correct.');
    }
    writeRecord_('Team', Object.assign({}, row, { Password: hashPassword_(next) }), row._row);
    return { changed: true };
  });
}

// ---------- Passwords ----------

function isHashed_(stored) {
  return String(stored || '').indexOf(HASH_PREFIX) === 0;
}

function hashPassword_(password, salt) {
  salt = salt || Utilities.getUuid().replace(/-/g, '');
  let digest = password;
  for (let i = 0; i < HASH_ROUNDS; i++) {
    digest = Utilities.base64Encode(Utilities.computeHmacSha256Signature(digest, salt));
  }
  return HASH_PREFIX + salt + '$' + digest;
}

function checkPassword_(password, stored) {
  if (!stored) return false;
  if (!isHashed_(stored)) return safeEqual_(password, stored);
  const salt = stored.slice(HASH_PREFIX.length).split('$')[0];
  return safeEqual_(hashPassword_(password, salt), stored);
}

// ---------- Sessions ----------

function createSession_(username) {
  const body = Utilities.base64EncodeWebSafe(
    JSON.stringify({ u: username, x: Date.now() + SESSION_HOURS * 3600 * 1000 }),
    Utilities.Charset.UTF_8
  );
  return body + '.' + sign_(body);
}

/** Validates the token and returns the current Team record (role may have changed). */
function requireSession_(token) {
  const parts = String(token || '').split('.');
  if (parts.length !== 2 || !safeEqual_(sign_(parts[0]), parts[1])) {
    throw new AppError('Please sign in again.', 401);
  }
  let data;
  try {
    data = JSON.parse(
      Utilities.newBlob(Utilities.base64DecodeWebSafe(parts[0])).getDataAsString('UTF-8')
    );
  } catch (err) {
    throw new AppError('Please sign in again.', 401);
  }
  if (!data.x || data.x < Date.now()) {
    throw new AppError('Your session has expired. Please sign in again.', 401);
  }
  const member = findMember_(data.u);
  if (!member) throw new AppError('Your access has been removed. Contact an admin.', 401);
  return member;
}

function sign_(text) {
  return Utilities.base64EncodeWebSafe(
    Utilities.computeHmacSha256Signature(text, getSessionSecret_())
  );
}

function getSessionSecret_() {
  const props = PropertiesService.getScriptProperties();
  let secret = props.getProperty('SESSION_SECRET');
  if (!secret) {
    secret = Utilities.getUuid() + Utilities.getUuid();
    props.setProperty('SESSION_SECRET', secret);
  }
  return secret;
}

function safeEqual_(a, b) {
  a = String(a); b = String(b);
  if (a.length !== b.length) return false;
  let diff = 0;
  for (let i = 0; i < a.length; i++) diff |= a.charCodeAt(i) ^ b.charCodeAt(i);
  return diff === 0;
}

function normUser_(v) {
  return String(v || '').trim().toLowerCase();
}

// ===================== Actions.gs =====================

/**
 * API actions. Each receives (payload, user) where user = { username, name, role }.
 */

const WEEK_RE = /^\d{4}-W\d{2}$/;

function requireWeek_(week) {
  const w = String(week || '').trim();
  if (!WEEK_RE.test(w)) throw new AppError('Invalid week. Expected format like 2026-W43.');
  return w;
}

// ---------- Member actions ----------

function actionMyProjects(p, user) {
  const mine = listAssignments_().filter(a => same_(a.username, user.username)).map(a => a.projectId);
  return listProjects_()
    .filter(pr => mine.indexOf(pr.id) !== -1)
    .sort((a, b) => (a.status === 'Closed') - (b.status === 'Closed') || String(a.name).localeCompare(b.name));
}

function actionMyUpdates(p, user) {
  return readTable_('WeeklyUpdates')
    .filter(r => same_(r.Username, user.username) && (!p.week || String(r.Week) === p.week))
    .map(mapUpdate_);
}

function actionSaveUpdate(p, user) {
  const week = requireWeek_(p.week);
  const projectId = String(p.projectId || '').trim();
  const project = listProjects_().find(pr => pr.id === projectId);
  if (!project) throw new AppError('Project not found.');

  const assigned = listAssignments_().some(a => a.projectId === projectId && same_(a.username, user.username));
  if (!assigned && user.role !== 'Admin') throw new AppError('You are not assigned to this project.', 403);

  const progress = p.progress === '' || p.progress === null || p.progress === undefined
    ? '' : Math.max(0, Math.min(100, Math.round(Number(p.progress) || 0)));

  return withLock_(() => {
    const existing = readTable_('WeeklyUpdates').find(r =>
      String(r.Week) === week && same_(r.Username, user.username) && String(r.ProjectID) === projectId);
    const now = nowStamp_();
    const record = Object.assign({}, existing || {}, {
      UpdateID: existing ? existing.UpdateID : Utilities.getUuid(),
      Week: week,
      Username: user.username,
      Name: user.name,
      ProjectID: projectId,
      ProjectName: project.name,
      DoneThisWeek: text_(p.done),
      PlanNextWeek: text_(p.next),
      Blockers: text_(p.blockers),
      Status: oneOf_(p.status, UPDATE_STATUSES, 'On Track'),
      Progress: progress,
      SubmittedAt: existing ? existing.SubmittedAt : now,
      UpdatedAt: now,
    });
    writeRecord_('WeeklyUpdates', record, existing && existing._row);
    return mapUpdate_(record);
  });
}

function actionListMeetings() {
  return readTable_('Meetings').map(mapMeeting_)
    .sort((a, b) => String(b.date).localeCompare(String(a.date)));
}

// ---------- Admin actions ----------

function actionSaveProject(p) {
  const name = text_(p.name, 200);
  if (!name) throw new AppError('Project name is required.');

  return withLock_(() => {
    const rows = readTable_('Projects');
    let id = text_(p.id, 50);
    const existing = id ? rows.find(r => String(r.ProjectID) === id) : null;
    if (!id) id = nextProjectId_(rows);

    const record = Object.assign({}, existing || {}, {
      ProjectID: id,
      Name: name,
      Type: oneOf_(p.type, PROJECT_TYPES, 'Other'),
      Client: text_(p.client, 200),
      Manager: text_(p.manager, 200),
      Status: oneOf_(p.status, PROJECT_STATUSES, 'Active'),
      StartDate: text_(p.startDate, 20),
      EndDate: text_(p.endDate, 20),
      Notes: text_(p.notes),
    });
    writeRecord_('Projects', record, existing && existing._row);
    return mapProject_(record);
  });
}

function nextProjectId_(rows) {
  let max = 0;
  rows.forEach(r => {
    const m = /^PRJ-(\d+)$/.exec(String(r.ProjectID));
    if (m) max = Math.max(max, Number(m[1]));
  });
  return 'PRJ-' + String(max + 1).padStart(4, '0');
}

function actionSaveMember(p, user) {
  const username = normUser_(p.username);
  if (!/^[a-z0-9._@-]{2,100}$/.test(username)) {
    throw new AppError('Username can use letters, numbers and . _ @ - (2–100 characters).');
  }
  const role = oneOf_(p.role, ROLES, 'Member');
  const active = p.active !== false;
  if (same_(username, user.username) && (role !== 'Admin' || !active)) {
    throw new AppError('You cannot remove your own admin access.');
  }
  const password = String(p.password || '');
  if (password && password.length < 8) throw new AppError('Password must be at least 8 characters.');

  return withLock_(() => {
    const existing = readTable_('Team').find(r => same_(r.Username, username));
    if (!existing && !password) throw new AppError('Set a password for the new member.');
    if (existing && p.isNew) throw new AppError('That username already exists.');
    const record = Object.assign({}, existing || {}, {
      Username: username, Name: text_(p.name, 200) || username, Role: role, Active: active,
    });
    if (password) record.Password = hashPassword_(password);
    writeRecord_('Team', record, existing && existing._row);
    return mapMember_(record);
  });
}

function actionSetAssignments(p) {
  const projectId = String(p.projectId || '').trim();
  if (!listProjects_().some(pr => pr.id === projectId)) throw new AppError('Project not found.');
  const usernames = Array.from(new Set((p.usernames || []).map(normUser_).filter(Boolean)));

  return withLock_(() => {
    const kept = listAssignments_().filter(a => a.projectId !== projectId);
    const records = kept.concat(usernames.map(u => ({ projectId: projectId, username: u })))
      .map(a => ({ ProjectID: a.projectId, Username: a.username }));
    rewriteTable_('Assignments', records);
    return { projectId: projectId, usernames: usernames };
  });
}

/** Everything the weekly meeting needs: all updates + who has not submitted. */
function actionWeekReport(p) {
  const week = requireWeek_(p.week);
  const projects = listProjects_();
  const team = listTeam_().filter(m => m.active);
  const updates = readTable_('WeeklyUpdates').filter(r => String(r.Week) === week).map(mapUpdate_);

  const openIds = projects.filter(pr => pr.status !== 'Closed' && pr.status !== 'Completed').map(pr => pr.id);
  const missing = [];
  listAssignments_().forEach(a => {
    if (openIds.indexOf(a.projectId) === -1) return;
    const member = team.find(m => m.username === a.username);
    if (!member) return;
    const has = updates.some(u => u.projectId === a.projectId && same_(u.username, a.username));
    if (!has) {
      const pr = projects.find(x => x.id === a.projectId);
      missing.push({ username: member.username, name: member.name, projectId: pr.id, projectName: pr.name });
    }
  });

  return { week: week, projects: projects, team: team, updates: updates, missing: missing };
}

function actionSaveMeeting(p, user) {
  const date = text_(p.date, 20);
  if (!/^\d{4}-\d{2}-\d{2}$/.test(date)) throw new AppError('Meeting date is required.');

  return withLock_(() => {
    const existing = p.id ? readTable_('Meetings').find(r => r.MeetingID === p.id) : null;
    const record = Object.assign({}, existing || {}, {
      MeetingID: existing ? existing.MeetingID : Utilities.getUuid(),
      Date: date,
      Week: p.week ? requireWeek_(p.week) : '',
      Title: text_(p.title, 200) || 'Weekly meeting',
      Attendees: text_(p.attendees, 2000),
      Notes: text_(p.notes, 20000),
      Decisions: text_(p.decisions, 10000),
      ActionItems: text_(p.actionItems, 10000),
      CreatedBy: existing ? existing.CreatedBy : user.username,
      CreatedAt: existing ? existing.CreatedAt : nowStamp_(),
    });
    writeRecord_('Meetings', record, existing && existing._row);
    return mapMeeting_(record);
  });
}

// ===================== Setup.gs =====================

/**
 * One-time setup. Open the Sheet → Extensions → Apps Script and run setup()
 * once (or use the "ACS Tracker → Set up / repair sheets" menu afterwards).
 * It creates any missing tabs/columns and never deletes data.
 */

function onOpen() {
  SpreadsheetApp.getUi()
    .createMenu('ACS Tracker')
    .addItem('Set up / repair sheets', 'setup')
    .addToUi();
}

function setup() {
  const ss = ss_();

  Object.keys(SHEETS).forEach(name => {
    const sh = ss.getSheetByName(name) || ss.insertSheet(name);
    const headers = SHEETS[name];
    if (sh.getLastRow() === 0) {
      sh.getRange(1, 1, 1, headers.length).setValues([headers]);
    } else {
      const existing = headers_(sh);
      const missing = headers.filter(h => existing.indexOf(h) === -1);
      if (missing.length) sh.getRange(1, existing.length + 1, 1, missing.length).setValues([missing]);
    }
    sh.getRange(1, 1, 1, sh.getLastColumn())
      .setFontWeight('bold').setBackground('#1f3a5f').setFontColor('#ffffff');
    sh.setFrozenRows(1);
  });

  // Keep IDs and week codes as plain text so Sheets never converts them.
  [['Projects', 'ProjectID'], ['Assignments', 'ProjectID'], ['WeeklyUpdates', 'ProjectID'],
   ['WeeklyUpdates', 'Week'], ['Meetings', 'Week'], ['Team', 'Password']].forEach(([name, col]) => {
    const sh = ss.getSheetByName(name);
    const idx = headers_(sh).indexOf(col) + 1;
    if (idx > 0) sh.getRange(2, idx, sh.getMaxRows() - 1, 1).setNumberFormat('@');
  });

  addValidation_(ss.getSheetByName('Projects'), 'Type', PROJECT_TYPES);
  addValidation_(ss.getSheetByName('Projects'), 'Status', PROJECT_STATUSES);
  addValidation_(ss.getSheetByName('Team'), 'Role', ROLES);
  addValidation_(ss.getSheetByName('WeeklyUpdates'), 'Status', UPDATE_STATUSES);
  const team = ss.getSheetByName('Team');
  const activeCol = headers_(team).indexOf('Active') + 1;
  // A checkbox rule (not insertCheckboxes) so empty rows stay empty and appendRow still works.
  team.getRange(2, activeCol, team.getMaxRows() - 1, 1)
    .setDataValidation(SpreadsheetApp.newDataValidation().requireCheckbox().build());

  getSessionSecret_();

  if (!readTable_('Team').some(r => isActive_(r.Active) && same_(r.Role, 'Admin'))) {
    console.warn('No active Admin yet: add a row to the Team tab (Username, Password, Name, Role = Admin, Active ticked).');
  }

  const blank = ss.getSheetByName('Sheet1');
  if (blank && blank.getLastRow() === 0 && ss.getSheets().length > 1) ss.deleteSheet(blank);

  console.log('Setup complete.');
}

function addValidation_(sh, column, values) {
  const idx = headers_(sh).indexOf(column) + 1;
  if (!idx) return;
  const rule = SpreadsheetApp.newDataValidation().requireValueInList(values, true).setAllowInvalid(false).build();
  sh.getRange(2, idx, sh.getMaxRows() - 1, 1).setDataValidation(rule);
}
